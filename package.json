{
  "name": "@guiqft/figma-slides-mcp",
  "version": "2.2.0",
  "description": "MCP server that bridges Claude Code and Figma Slides via a Figma plugin",
  "type": "module",
  "bin": {
    "figma-slides-mcp": "mcp/dist/mcp-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "mcp/dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:mcp": "node mcp/build.mjs",
    "dev:mcp": "node mcp/build.mjs --watch",
    "typecheck": "tsc --noEmit -p mcp/tsconfig.json && tsc --noEmit -p mcp/figma-plugin/tsconfig.json",
    "format": "prettier --write \"mcp/**/*.{ts,mjs,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"mcp/**/*.{ts,mjs,html}\" \".github/**/*.yml\"",
    "test": "npm run build:mcp && node --test \"mcp/test/*.test.mjs\"",
    "prepublishOnly": "npm run build:mcp"
  },
  "keywords": [
    "mcp",
    "figma",
    "figma-slides",
    "model-context-protocol",
    "ai",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guiqft/figma-slides-mcp.git"
  },
  "homepage": "https://github.com/Guiqft/figma-slides-mcp",
  "devDependencies": {
    "@figma/plugin-typings": "^1.106.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  }
}
